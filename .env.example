# Copy to .env and fill in whichever platform you actually use. .env is gitignored.
#
# Gotcha worth remembering: load_dotenv() has to run before any os.getenv() call
# and before the League object gets constructed, otherwise everything reads back
# as None and you get a confusing auth error instead of a missing-config error.

# --- ESPN ---
# League ID is always required. S2 and SWID are browser cookies and are only
# needed if the league is private.
ESPN_LEAGUE_ID=
ESPN_YEAR=
ESPN_S2=
ESPN_SWID=

# --- Sleeper ---
# Public API, no auth at all. League ID is the whole story.
SLEEPER_LEAGUE_ID=

# --- Yahoo ---
# Needs an app registered at developer.yahoo.com first (manual step, can't be
# scripted). Keep the refresh token around so runs don't re-prompt every time.
YAHOO_LEAGUE_ID=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=
